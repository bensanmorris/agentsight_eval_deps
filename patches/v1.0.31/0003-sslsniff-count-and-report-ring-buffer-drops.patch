 	while (!exiting) {
 		err = ring_buffer__poll(rb, PERF_POLL_TIMEOUT_MS);
 		if (err < 0 && err != -EINTR) {
@@ -855,7 +883,9 @@ int main(int argc, char **argv) {
 			goto cleanup;
 		}
 		err = 0;
+		report_ringbuf_drops(drops_fd, false);
 	}
+	report_ringbuf_drops(drops_fd, true);
 
 cleanup:
